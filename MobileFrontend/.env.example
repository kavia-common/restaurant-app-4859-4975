# Environment configuration for MobileFrontend (Flutter)
# Copy this file to ".env" and fill in values for your environment.
# Never commit your ".env" with real secrets to source control.

# =========================
# Required variables
# =========================

# Base URL for the backend REST API the app communicates with.
# Example: https://api.example.com or http://10.0.2.2:8080 for Android emulator
API_BASE_URL=https://api.example.com

# Instagram integration (usually via your backend/proxy that talks to Instagram Graph API).
# Your backend may require these to fetch business media; consult backend docs.
INSTAGRAM_BUSINESS_ID=17841400000000000
INSTAGRAM_ACCESS_TOKEN=IGQVJXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Public site URL used for deep links, email redirect targets, and external references.
# This should match the final deployed domain of your app's web presence.
SITE_URL=https://restaurant.example.com

# Default message prefilled when opening WhatsApp chat from the app.
WHATSAPP_DEFAULT_MESSAGE=Hello! I would like to make an inquiry about your menu.

# =========================
# Optional variables
# =========================

# Client-side analytics key (e.g., Segment write key). Leave empty to disable.
ANALYTICS_WRITE_KEY=SEGMENT_WRITE_KEY_XXXX

# Push sender ID (e.g., Firebase Cloud Messaging sender ID or project number) for Android.
# iOS configuration will happen in platform-specific files.
PUSH_SENDER_ID=123456789012

# Maps URL template if you want to override the default Google Maps link.
# Placeholders: {lat} and {lng}. Example shown for Google Maps search.
MAPS_URL_TEMPLATE=https://www.google.com/maps/search/?api=1&query={lat},{lng}

# Additional notes:
# - Set sensitive values through CI/CD environment management or secrets manager.
# - Ensure pubspec.yaml includes `.env` in assets (already configured).
# - If you add new env keys, document them here and in README_ENV.md.
