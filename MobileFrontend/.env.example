# PUBLIC_INTERFACE
# Example environment variables for the Restaurant Mobile App.
# Copy to .env and fill values as needed. Do not commit the .env file.

# Backend API base URL (if available)
API_BASE_URL=https://api.example.com

# Instagram feed token or endpoint (placeholder)
INSTAGRAM_FEED_URL=https://instagram.com/yourrestaurant

# Payment gateway keys (do not hardcode in production; use secure config)
PAYMENT_PUBLIC_KEY=pk_test_xxx

# Site URL for deep-links/email redirects (if using Supabase or auth providers)
SITE_URL=https://example.com
