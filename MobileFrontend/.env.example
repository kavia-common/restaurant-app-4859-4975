# Environment variables template for MobileFrontend (Flutter)
# Copy this file to ".env" and fill in the values for your environment.
# Do NOT commit the real .env file. It is excluded by .gitignore.

# App
APP_ENV=development
APP_NAME=Restaurant App
APP_LOCALE=en

# Backend API
API_BASE_URL=https://api.example.com
WEBSOCKET_URL=wss://api.example.com/ws

# Third-party integrations
INSTAGRAM_FEED_TOKEN=
WHATSAPP_PHONE_NUMBER=+0000000000

# Auth and tokens (example placeholders; replace with actual providers when integrated)
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Payment gateways (placeholders)
STRIPE_PUBLISHABLE_KEY=
STRIPE_MERCHANT_ID=
PAYPAL_CLIENT_ID=

# Maps / Location
GOOGLE_MAPS_API_KEY=

# Notifications (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=

# Misc
SENTRY_DSN=
